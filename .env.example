# Copy to .env.local and fill in. Never commit real values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser — never put secrets in them.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BUSINESS_TIMEZONE=Asia/Manila

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — only imported from server-only modules.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="Light Chasers Studio <bookings@example.com>"

# --- Bot protection (Cloudflare Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Payments (PayMongo) ---
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
