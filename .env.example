# Copy to .env.local and fill in. Never commit real values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser — never put secrets in them.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BUSINESS_TIMEZONE=Asia/Manila

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — only imported from server-only modules.
SUPABASE_SERVICE_ROLE_KEY=
# DEV project only, used by `npm run test:db` (Settings > Database > connection string,
# session pooler, role postgres). Tests run in rolled-back transactions.
DATABASE_URL_TEST=

# --- Integrations: optional in development, REQUIRED in production ---
# Without them: emails are skipped (logged), Turnstile is skipped in dev only
# (production refuses bookings), and online booking says payment is unavailable.

# --- Email: the studio Gmail (used first when both are set; also in trial mode) ---
# Google Account -> Security -> 2-Step Verification on, then
# https://myaccount.google.com/apppasswords -> "Booking website" -> 16 letters, no spaces.
# Changing the Gmail password cancels the app password. Limit ~500 emails/day.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Email (Resend; only with a domain the studio owns) ---
RESEND_API_KEY=
EMAIL_FROM="Light Chasers Studio <bookings@example.com>"

# --- Bot protection (Cloudflare Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Payments (PayMongo, Developers → API keys; use sk_test_ keys until live) ---
PAYMONGO_SECRET_KEY=
# From the webhook you register at <site>/api/webhooks/paymongo for checkout_session.payment.paid
PAYMONGO_WEBHOOK_SECRET=
# Methods activated on the PayMongo account (Settings → Payment methods), comma separated.
# Listing one that isn't active makes PayMongo refuse every checkout. Default: qrph.
# Codes: qrph, gcash, paymaya, card, grab_pay, shopee_pay, billease, dob, dob_ubp,
# brankas_bdo, brankas_landbank, brankas_metrobank
PAYMONGO_PAYMENT_METHODS=qrph

# --- Trial mode (local testing only) ---
# true = pretend PayMongo/Resend/Turnstile are set up: "Pay deposit" opens a fake
# checkout (/book/mock-checkout), emails are saved to .mock-emails/ and shown at
# /admin/trial-emails. Ignored on the live Vercel site (VERCEL_ENV=production).
# PAYMENTS_MOCK=true
